# =========================================================
# Rezouette Backend - Environment Configuration Example
# =========================================================
# Copy this file to .env for local development.
# Never commit real credentials, tokens or API secrets.

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------

DATABASE_URL=postgresql://username:password@localhost:5432/rezouette

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

PORT=3000
NODE_ENV=development

FRONTEND_URL=http://localhost:4200
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------
# Shared OAuth Security
# ---------------------------------------------------------

OAUTH_STATE_SECRET=your_oauth_state_secret_here
OAUTH_STATE_TTL_SECONDS=
OAUTH_FRONTEND_CALLBACK_PATH=

# ---------------------------------------------------------
# Meta - Facebook & Instagram
# ---------------------------------------------------------

META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=
META_GRAPH_VERSION=

# ---------------------------------------------------------
# LinkedIn
# ---------------------------------------------------------

LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=

LINKEDIN_SCOPES=
LINKEDIN_OAUTH_BASE_URL=
LINKEDIN_API_BASE_URL=
LINKEDIN_API_VERSION=

# disabled | rest | ugc
# Keep disabled until real provider validation is completed.
LINKEDIN_PUBLISH_API=disabled

# ---------------------------------------------------------
# TikTok
# ---------------------------------------------------------

TIKTOK_REDIRECT_URI=
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_SCOPES=

# ---------------------------------------------------------
# YouTube / Google OAuth
# ---------------------------------------------------------

YOUTUBE_CLIENT_ID=your_google_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REDIRECT_URI=

# Keep disabled until real provider validation is completed.
YOUTUBE_PUBLISHING_ENABLED=false

YOUTUBE_SCOPES=
YOUTUBE_OAUTH_AUTHORIZATION_URL=
YOUTUBE_OAUTH_TOKEN_URL=
YOUTUBE_API_BASE_URL=
YOUTUBE_UPLOAD_BASE_URL=

# Token / upload settings
YOUTUBE_TOKEN_REFRESH_SKEW_SECONDS=600
YOUTUBE_UPLOAD_CHUNK_SIZE_BYTES=8388608
YOUTUBE_UPLOAD_MAX_RETRIES=3
YOUTUBE_UPLOAD_RETRY_BASE_MS=1000
YOUTUBE_UPLOAD_REQUEST_TIMEOUT_MS=120000

# Processing reconciliation
YOUTUBE_RECONCILE_INTERVAL_MS=
YOUTUBE_RECONCILE_BATCH_SIZE=25
YOUTUBE_RECONCILE_MAX_AGE_HOURS=48
YOUTUBE_RECONCILE_NOT_FOUND_GRACE_SECONDS=300
YOUTUBE_RECONCILE_REQUEST_TIMEOUT_MS=30000

# ---------------------------------------------------------
# Threads
# ---------------------------------------------------------

THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here

# ---------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here